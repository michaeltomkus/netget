# Anthropic (Claude) API key — required. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Backend server port
PORT=4000

# Comma-separated list of origins allowed to call the API (frontend dev server, etc.)
CORS_ORIGIN=http://localhost:5173

# --- Voice (Phase 2+) ---

# Azure AI Speech — Neural TTS (interviewer voice). Both required together.
# REQUIRED in practice: questions are audio-only (no text shown on screen,
# no captions fallback), so without a working key every question hard-blocks.
# Get a key at https://portal.azure.com (create a "Speech" resource).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: any Azure neural voice name. Defaults to en-US-AriaNeural.
AZURE_SPEECH_VOICE=

# Deepgram — live streaming speech-to-text (candidate's spoken answers).
# REQUIRED in practice: answering is voice-only (no typing fallback), so
# without this key no question in any session can be answered at all.
# Get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- Accounts, database, billing ---

# Postgres connection string. Required — sessions/questions/grading/users
# are stored here (see backend/prisma/schema.prisma). Run `npx prisma
# migrate deploy` (from backend/) against it before first run.
DATABASE_URL=postgresql://postgres:password@localhost:5432/interviewai

# Clerk — federated sign-in (Google and whatever other providers you enable
# in the Clerk dashboard). We never see or store a password. Required for
# any authenticated route to work — get keys at https://dashboard.clerk.com
CLERK_SECRET_KEY=
# Also set in frontend/.env as VITE_CLERK_PUBLISHABLE_KEY (same value,
# Clerk's publishable/public key — safe to expose client-side).
VITE_CLERK_PUBLISHABLE_KEY=

# Comma-separated emails granted the admin role (metrics dashboard access)
# the first time they sign in. Case-insensitive.
ADMIN_EMAILS=

# Stripe — subscription billing. We never see or store card data; Checkout
# and the Customer Portal are both hosted by Stripe. Get keys at
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
