# Anthropic (Claude) API key — required. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Backend server port
PORT=4000

# Comma-separated list of origins allowed to call the API (frontend dev server, etc.)
CORS_ORIGIN=http://localhost:5173

# --- Voice (Phase 2+) ---

# Azure AI Speech — Neural TTS (interviewer voice). Both required together.
# REQUIRED in practice: questions are audio-only (no text shown on screen,
# no captions fallback), so without a working key every question hard-blocks.
# Get a key at https://portal.azure.com (create a "Speech" resource).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: any Azure neural voice name. Defaults to en-US-AriaNeural.
AZURE_SPEECH_VOICE=

# Deepgram — live streaming speech-to-text (candidate's spoken answers).
# REQUIRED in practice: answering is voice-only (no typing fallback), so
# without this key no question in any session can be answered at all.
# Get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- Accounts, database, billing ---

# Postgres connection string. Required — sessions/questions/grading/users
# are stored here (see backend/prisma/schema.prisma). Run `npx prisma
# migrate deploy` (from backend/) against it before first run.
DATABASE_URL=postgresql://postgres:password@localhost:5432/interviewai

# Clerk — federated sign-in (Google and whatever other providers you enable
# in the Clerk dashboard). We never see or store a password. Required for
# any authenticated route to work — get keys at https://dashboard.clerk.com
CLERK_SECRET_KEY=
# Also set in frontend/.env as VITE_CLERK_PUBLISHABLE_KEY (same value,
# Clerk's publishable/public key — safe to expose client-side).
VITE_CLERK_PUBLISHABLE_KEY=

# Comma-separated emails granted the admin role (metrics dashboard access)
# the first time they sign in. Case-insensitive.
ADMIN_EMAILS=

# Stripe — subscription billing. We never see or store card data; Checkout
# and the Customer Portal are both hosted by Stripe. Get keys at
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Two plan tiers, each its own recurring Stripe Price id (create both as
# Prices on one Product, or two Products — either works). A plan is only
# offered at checkout once its price id is set here; leaving one unset just
# hides that plan rather than breaking anything. Display name/tagline live
# in code (backend/src/services/stripe.ts) — only the price itself comes
# from Stripe, so changing an amount in the dashboard needs no deploy.
# Pro: unlimited sessions. Premium: unlimited sessions + a personalized
# AI-generated practice plan after every session (see
# backend/src/services/grading/improvementPlan.ts).
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# For an existing subscriber to switch between Pro and Premium, configure
# both Prices under the same Product (or add both Products) in the Stripe
# Customer Portal's configuration (Settings → Billing → Customer portal) so
# "Manage billing" lets them change plans — this app deliberately never
# creates a second Checkout subscription for an already-subscribed user, to
# avoid double-billing them.

# --- Error monitoring (optional) ---

# Sentry — captures unhandled backend errors/rejections and reports for
# routes/stripeWebhook.ts + grading failures that are already handled
# locally but still worth alerting on. Without a DSN, this is a no-op.
# Get a DSN at https://sentry.io (create a Node project).
SENTRY_DSN=
# Also set in frontend/.env as VITE_SENTRY_DSN (a separate Sentry project —
# create it as a React project) for frontend render-crash reporting via an
# error boundary around the whole app.
VITE_SENTRY_DSN=
