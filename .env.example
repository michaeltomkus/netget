# Anthropic (Claude) API key — required. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Backend server port
PORT=4000

# Comma-separated list of origins allowed to call the API (frontend dev server, etc.)
CORS_ORIGIN=http://localhost:5173

# --- Voice (Phase 2+) ---

# Azure AI Speech — Neural TTS (interviewer voice). Both required together.
# Without these the interviewer has no voice (captions only) — the session
# still works fine, this pair is genuinely optional.
# Get a key at https://portal.azure.com (create a "Speech" resource).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional: any Azure neural voice name. Defaults to en-US-AriaNeural.
AZURE_SPEECH_VOICE=

# Deepgram — live streaming speech-to-text (candidate's spoken answers).
# REQUIRED in practice: answering is voice-only (no typing fallback), so
# without this key no question in any session can be answered at all.
# Get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=
