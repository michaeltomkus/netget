// Prisma schema — the application's live transactional store (Postgres).
// Replaces the flat-JSON-file store used through Phase 6; that store was
// always a placeholder (see the old db/store.ts header comment) and this is
// the point where real user accounts + payment webhooks make a real
// database necessary: concurrent-safe writes, exactly-once webhook
// processing, and queryable admin metrics aren't things a single JSON file
// can do safely.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum Seniority {
  junior
  mid
  senior
  staff
  exec
}

enum StressIntensity {
  low
  medium
  high
}

enum SessionStatus {
  scheduled
  in_progress
  completed
  graded
  abandoned
}

enum QuestionType {
  behavioral
  technical
  out_of_box
  stress
}

enum ExpectedStructure {
  STAR
  technical_walkthrough
  open_ended
}

// Mirrors Stripe's own subscription status values directly — no local
// reinterpretation — so webhook syncing is a straight pass-through.
enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
  incomplete_expired
  unpaid
  paused
}

model User {
  id               String   @id @default(uuid())
  /// Clerk's user id — the source of truth for identity. We never store a
  /// password or a Google token ourselves; Clerk handles the OAuth flow and
  /// hands us a verified session, this is just the foreign key into it.
  clerkUserId      String   @unique
  email            String   @unique
  name             String?
  role             Role     @default(user)
  /// Set from ADMIN_EMAILS at provisioning time — see services/auth/provisionUser.ts.
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())

  sessions         Session[]
  subscriptions    Subscription[]
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id])
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId])
}

model Session {
  id                       String          @id @default(uuid())
  userId                   String
  user                     User            @relation(fields: [userId], references: [id])
  createdAt                DateTime        @default(now())
  role                     String
  seniority                Seniority
  companyContext           String?
  stressIntensity          StressIntensity
  status                   SessionStatus
  /// The catalog entry this session was scheduled against — see JobRole.
  /// Optional: legacy sessions created before the role catalog existed have
  /// none. Plain scalar, not a Prisma relation (same denormalized-for-query
  /// posture as questionSetId below) — a JobRole is never deleted once
  /// created, so there's no dangling-reference risk to guard against.
  jobRoleId                String?
  /// Denormalized convenience copy of this session's own QuestionSet id —
  /// each session gets its own set, assembled by sampling from its
  /// JobRole's growing question bank (see BankQuestion) rather than reusing
  /// one fixed set verbatim — see routes/sessions.ts / questionGeneration.ts.
  questionSetId            String?
  scheduledDurationMinutes Int
  /// Null until the candidate is actually answering — for a freshly-approved
  /// role this stays null through the whole 5-minute buffer; set by
  /// POST /:id/begin once scheduledFor has passed and questionSetId is
  /// ready. Time-management grading measures from here, not from creation.
  startedAt                DateTime?
  /// Earliest moment a "scheduled" (buffered) session may begin — null for
  /// the instant-start path (an already-cached role), set to
  /// createdAt + 5min for a freshly-approved one.
  scheduledFor             DateTime?
  endedAt                  DateTime?
  recordingConsent         Boolean         @default(false)
  /// Server-local disk paths to sampled presentation frames — present only
  /// between "submitted at Finish" and "grading pipeline deleted them".
  presentationFrameRefs    String[]        @default([])
  presentationSignals      Json?

  questionSet              QuestionSet?
  responses                Response[]
  gradingResult            GradingResult?

  @@index([userId])
}

enum JobRoleStatus {
  approved
  rejected
}

/// The job-role catalog behind scheduling autocomplete. A row is created the
/// moment someone requests a role that doesn't already have one for that
/// seniority — see services/jobRoleClassifier.ts + routes/jobRoles.ts —
/// never edited afterward except to attach its cached questionSet and bump
/// usageCount. Rejected rows are kept (not deleted) so the same unpopular
/// title+seniority doesn't re-spend a Claude call every time it's retried.
model JobRole {
  id                  String        @id @default(uuid())
  /// Claude's normalized, display-ready form ("Backend Engineer") — never
  /// the candidate's raw typed text.
  title               String
  /// Lowercase/whitespace-collapsed title — the actual (title, seniority)
  /// matching key; see @@unique below.
  normalizedKey       String
  seniority           Seniority
  status              JobRoleStatus
  /// 0-100 — Claude's own-knowledge estimate of how common/interview-relevant
  /// this role+seniority is. A heuristic judgment call, not real
  /// labor-market data (no such provider is integrated in this app) — see
  /// services/jobRoleClassifier.ts for the exact prompt and threshold.
  saturationScore     Int
  saturationRationale String
  createdAt           DateTime      @default(now())
  /// How many sessions have been scheduled against this role since — a
  /// rough proxy for "how established is this entry," surfaced nowhere yet
  /// but useful once there's a reason to prune or feature roles.
  usageCount          Int           @default(0)
  /// Denormalized count of this role's BankQuestion rows — avoids an extra
  /// count query on every autocomplete result just to know whether there's
  /// enough banked to schedule instantly (see MIN_BANK_SIZE in
  /// routes/sessions.ts). Bumped whenever growQuestionBank() inserts rows.
  bankSize            Int           @default(0)

  bankQuestions       BankQuestion[]

  @@unique([normalizedKey, seniority])
  @@index([seniority, status])
}

/// The growing, reusable pool of interview questions behind one role —
/// replaces an earlier design that cached one fixed 8-10 question set per
/// role and replayed it identically to every candidate (a "static path,"
/// easily memorized). Each session instead samples a fresh composition from
/// this pool (see questionGeneration.ts assembleSessionQuestionSet), and the
/// pool itself keeps growing over time (growQuestionBank) toward hundreds of
/// questions spread across disciplines, up to a cost-bounding ceiling.
model BankQuestion {
  id                  String             @id @default(uuid())
  jobRoleId           String
  jobRole             JobRole            @relation(fields: [jobRoleId], references: [id])
  type                QuestionType
  /// Free-text sub-topic tag Claude assigns during generation (e.g. "system
  /// design", "debugging", "team conflict", "estimation") — deliberately not
  /// a fixed enum, so coverage can grow organically per role rather than
  /// being capped by a taxonomy maintained by hand.
  discipline          String
  text                String
  /// Grading rubric — never sent to the candidate.
  idealAnswerCriteria String
  expectedStructure   ExpectedStructure?
  followUpTriggers    String[]           @default([])
  /// Synthesized once, here, and copied (not re-synthesized) into every
  /// session's own Question row that draws this bank question — see
  /// questionGeneration.ts.
  ttsAudioBlobRef     String?
  createdAt           DateTime           @default(now())
  /// How many sessions have drawn this specific question — sampling favors
  /// the least-used rows first, so a small bank still rotates instead of
  /// always handing out the same top few.
  timesUsed           Int                @default(0)

  @@index([jobRoleId, type])
}

model QuestionSet {
  id        String     @id @default(uuid())
  /// Back to one-per-session (each session gets its own assembled draw from
  /// its role's BankQuestion pool) — a role's shared/reusable data now
  /// lives in BankQuestion, not here.
  sessionId String     @unique
  session   Session    @relation(fields: [sessionId], references: [id])
  questions Question[]
}

model Question {
  id                  String             @id @default(uuid())
  questionSetId       String
  questionSet         QuestionSet        @relation(fields: [questionSetId], references: [id])
  order                Int
  type                QuestionType
  text                String
  /// Grading rubric generated alongside the question — never sent to the candidate.
  idealAnswerCriteria String
  expectedStructure   ExpectedStructure?
  followUpTriggers    String[]           @default([])
  /// Public path (served under /media) to pre-synthesized TTS audio, if TTS is configured.
  ttsAudioBlobRef     String?

  responses           Response[]

  @@index([questionSetId])
}

model Response {
  id         String   @id @default(uuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  transcript String
  createdAt  DateTime @default(now())
  /// DynamicFollowUp[] — live interruptions injected mid-answer, stress questions only.
  dynamicFollowUps Json?

  @@index([sessionId])
  @@index([questionId])
}

model GradingResult {
  id                   String   @id @default(uuid())
  sessionId            String   @unique
  session              Session  @relation(fields: [sessionId], references: [id])
  generatedAt          DateTime @default(now())
  /// PerQuestionGrade[]
  perQuestion          Json
  /// PresentationGrade | null — present only when consented + frames captured.
  presentation         Json?
  /// ComposureGrade | null — present only when a live interruption fired.
  composureUnderStress Json?
  /// TimeManagement — always present.
  timeManagement       Json
  overallScore         Int
  overallSummary       String
  topStrengths         String[]
  topGrowthAreas       String[]
  /// ImprovementPlan | null — Premium-plan-only, generated post-grading (see
  /// services/grading/improvementPlan.ts); absent for free/Pro sessions.
  improvementPlan      Json?
}
