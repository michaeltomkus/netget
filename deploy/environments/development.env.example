# Environment tier: development
# Deployed automatically by .github/workflows/deploy.yml on every push to the
# default branch, once build-and-test passes. No approval gate. See
# docs/ENVIRONMENTS.md for the full tier lineup and promotion path.
#
# This is a reference for which vars this tier's real secrets should set —
# copy the ones you need into the GitHub Environment named "development"
# (Settings -> Environments -> development -> Secrets), not into this file.
# See the root .env.example for what each var does; only tier-specific
# guidance is repeated here.

NODE_ENV=development

# Loosest tier — fine to point at shared/synthetic data, a scratch Postgres
# instance, and Stripe *test mode* keys (STRIPE_SECRET_KEY starting sk_test_,
# price ids from your Stripe test dashboard). Never point this tier at a
# production database.
DATABASE_URL=

# Same-origin dev frontend only.
CORS_ORIGIN=http://localhost:5173

ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
DEEPGRAM_API_KEY=

CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Fine to leave empty here — every dev/team-member email that needs the
# admin dashboard, comma-separated.
ADMIN_EMAILS=

# Test mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# Optional here — noisy to route every local/dev exception to Sentry.
SENTRY_DSN=
VITE_SENTRY_DSN=
