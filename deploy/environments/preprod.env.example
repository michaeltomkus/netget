# Environment tier: preprod (pre-production)
# Requires manual approval — this job in .github/workflows/deploy.yml pauses
# on the "preprod" GitHub Environment until a designated reviewer approves
# the run (Settings -> Environments -> preprod -> required reviewers). See
# docs/ENVIRONMENTS.md for exactly how to configure that gate and for the
# full tier lineup and promotion path.
#
# This is a reference for which vars this tier's real secrets should set —
# copy the ones you need into the GitHub Environment named "preprod"
# (Settings -> Environments -> preprod -> Secrets), not into this file. See
# the root .env.example for what each var does; only tier-specific guidance
# is repeated here.

NODE_ENV=production

# Should mirror production's shape as closely as possible (same migrations
# applied, comparable data volume) so a preprod pass is actually predictive
# of production — but still its own separate database, never the real one.
DATABASE_URL=

CORS_ORIGIN=

ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
DEEPGRAM_API_KEY=

CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

ADMIN_EMAILS=

# Still Stripe *test mode* — preprod is the last tier before real money is
# involved, so a checkout walkthrough here should still use test-mode keys
# and Stripe's test card numbers, not live ones.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# Required here — this tier exists to catch what UAT didn't before
# production sees it.
SENTRY_DSN=
VITE_SENTRY_DSN=
