# Environment tier: production
# Requires manual approval — this job in .github/workflows/deploy.yml pauses
# on the "production" GitHub Environment until a designated reviewer
# approves the run (Settings -> Environments -> production -> required
# reviewers). Use a stricter/smaller reviewer list here than preprod — see
# docs/ENVIRONMENTS.md for exactly how to configure that gate and for the
# full tier lineup and promotion path.
#
# This is a reference for which vars this tier's real secrets should set —
# copy the ones you need into the GitHub Environment named "production"
# (Settings -> Environments -> production -> Secrets), not into this file.
# See the root .env.example for what each var does; only tier-specific
# guidance is repeated here.

NODE_ENV=production

# The real database. Back it up before every migration.
DATABASE_URL=

# The real production frontend URL.
CORS_ORIGIN=

ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
DEEPGRAM_API_KEY=

CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Real admins only — keep this list short.
ADMIN_EMAILS=

# Live mode (sk_live_...) — real card charges happen here. Double-check
# STRIPE_WEBHOOK_SECRET matches the webhook endpoint registered for this
# tier's actual URL in the Stripe dashboard, not a test-mode one.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# Required — this is the one tier where "fails silently" is unacceptable.
SENTRY_DSN=
VITE_SENTRY_DSN=
