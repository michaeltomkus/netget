# Environment tier: uat (user acceptance testing)
# Deployed automatically by .github/workflows/deploy.yml once development
# succeeds. No approval gate — UAT is where testers/stakeholders sign off
# before anything is allowed to escalate to preprod. See
# docs/ENVIRONMENTS.md for the full tier lineup and promotion path.
#
# This is a reference for which vars this tier's real secrets should set —
# copy the ones you need into the GitHub Environment named "uat" (Settings
# -> Environments -> uat -> Secrets), not into this file. See the root
# .env.example for what each var does; only tier-specific guidance is
# repeated here.

NODE_ENV=production

# Its own database, isolated from development and from preprod/production —
# UAT data (test accounts, seeded sessions) should never leak into or out of
# another tier.
DATABASE_URL=

# The UAT tier's own deployed frontend URL, not localhost.
CORS_ORIGIN=

ANTHROPIC_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
DEEPGRAM_API_KEY=

CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Whoever is running acceptance testing/sign-off.
ADMIN_EMAILS=

# Test mode — UAT walkthroughs (including billing flows) must never move
# real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=

# Recommended on here — catching a real error before it reaches preprod is
# the point of this tier.
SENTRY_DSN=
VITE_SENTRY_DSN=
